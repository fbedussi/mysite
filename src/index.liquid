                    </ul>
                </div>
                <div>
                    <h3>Backend</h3>
                    <ul>
                        <li>NodeJS</li>
                        <li>Rust</li>
                        <li>Elixir</li>
                        <li>PHP</li>
                        <li>.NET</li>
                        <li>MySQL</li>
                        <li>MongoDB</li>
                        <li>Express</li>
                        <li>Fastify</li>
                        <li>Symfony</li>
                        <li>Redis</li>
                        <li>Electron</li>
                        <li>Wordpress</li>
                        <li>Joomla</li>
                    </ul>
                </div>
            </div>
        </details>
    </main>

    <div class="portfolio">
        <div class="boxed">
            <h2>Portfolio</h2>

            <ul>
                {% for proj in projects %}
                <li>
                    <figure>
                        <button commandfor="dialog-{{proj.id}}" command="show-modal">
                            <img sizes="(max-width: 1400px) 100vw, 1400px" {% if proj.srcset %} srcset="{{proj.srcset}}"
                                {% endif %} src="{{proj.src}}" loading="lazy" alt="{{ proj.name }} screenshot">
                        </button>
                        <figcaption>{{ proj.name}} <small>({{ proj.year}})</small></figcaption>
                    </figure>
                    <dialog id="dialog-{{proj.id}}" closedby="any">
                        <img sizes="(max-width: 1400px) 100vw, 1400px" {% if proj.srcset %} srcset="{{proj.srcset}}" {%
                            endif %} src="{{proj.src}}" loading="lazy" alt="{{ proj.name }} screenshot">
                        <button commandfor="dialog-{{proj.id}}" command="close">✕</button>
                    </dialog>

                </li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <footer>
        <div class="boxed">
            <h2>Contacts</h2>
            <ul>
                <li><a href="https://github.com/fbedussi" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                <li><a href="https://www.linkedin.com/in/francescobedussi/" target="_blank"  rel="noopener noreferrer">LinkedIn</a></li>
                <li><a href="https://fbedussi.github.io/blog/" target="_blank">Frontend no stress, my
                        blog</a></li>
                <li>francesco [at] francescobedussi [.] it</li>
            </ul>
        </div>
    </footer>
</body>

</html>